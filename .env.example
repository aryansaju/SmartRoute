# Copy to .env (never commit .env). All values below are the defaults unless noted.
LISTEN_ADDR=:8080

# Upstream: the OpenAI compatible server the gateway forwards misses to (no /v1 suffix).
UPSTREAM_BASE_URL=http://localhost:9000
UPSTREAM_API_KEY=

# Optional: require clients to send "Authorization: Bearer <this>". Empty means open (development only).
GATEWAY_API_KEY=

# Storage and embeddings. Leave empty to use the in memory store and the fake hash embedder (development only).
DATABASE_URL=postgres://smartroute:smartroute@localhost:5432/smartroute?sslmode=disable
EMBEDDER_URL=http://localhost:8001

# Cache behaviour
CACHE_ENABLED=true
SEMANTIC_ENABLED=true
SEMANTIC_THRESHOLD=0.92     # starting point only: tune it with bench/cache_quality
SEMANTIC_TOP_K=3
SEMANTIC_MAX_CHARS=1000     # longer prompts are exact match only (embedding models truncate long input)
GUARD_ENABLED=true
CACHE_TTL=24h
L1_SIZE=10000

# Cost estimates: real prices change, so supply the ones you use. Values are USD per 1M tokens.
# PRICES_JSON={"gpt-4o-mini":{"input_per_1m":0.0,"output_per_1m":0.0}}   # <- fill in from the provider's pricing page

LOG_LEVEL=info
